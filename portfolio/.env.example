# Copy to .env.local (never commit real values). Public, non-secret values are
# read at BUILD time for static pages — rebuild after changing them.

# Canonical production origin, https only, no trailing slash. Leave empty for
# previews: canonical/Open Graph URLs are then omitted rather than faked.
SITE_URL=

# Set to "allow" only when launching on SITE_URL with real content. Anything
# else keeps every page noindex (also forced while placeholders/samples exist).
SITE_INDEXING=

# --- Contact form (server-only secrets) -----------------------------------
# Resend API key (https://resend.com). Without all three values the form shows
# an honest "not connected" state and nothing is sent.
RESEND_API_KEY=
# Inbox that receives inquiries.
CONTACT_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "Portfolio <form@mail.yourdomain.com>".
CONTACT_FROM_EMAIL=

# Shared rate limiting across serverless instances (Upstash Redis REST).
# Without these, a per-process memory limiter is used (single server only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Requests allowed per client per window (defaults: 5 per 600 s).
CONTACT_RATE_LIMIT_MAX=
CONTACT_RATE_LIMIT_WINDOW_SECONDS=
# Header carrying the real client IP as set by your host (default x-forwarded-for).
CONTACT_IP_HEADER=

# Optional anonymous Web Vitals logging to /api/vitals ("true" to enable).
NEXT_PUBLIC_WEB_VITALS=

# --- Content management (Keystatic, see docs/cms.md) ----------------------
# Empty = local mode: /keystatic works only under `pnpm dev` and edits files
# on disk (commit them yourself). Production keeps /keystatic disabled (404).
# "github" = edits are commits to the repo below; needs the GitHub App values.
NEXT_PUBLIC_KEYSTATIC_STORAGE=
# owner/repo that holds this site.
NEXT_PUBLIC_KEYSTATIC_REPO=
# Folder of this app inside the repo (default "portfolio"; set empty if it is the repo root).
NEXT_PUBLIC_KEYSTATIC_PATH_PREFIX=
# GitHub App credentials (server-only secrets). Keystatic can create the app
# and fill these in for you the first time you open /keystatic in GitHub mode.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`).
KEYSTATIC_SECRET=
# Slug of the GitHub App (used for the "install app" link).
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# --- Analytics (optional, off by default; both are cookieless) ------------
# "vercel" (Vercel Web Analytics) or "plausible". Empty = no analytics.
NEXT_PUBLIC_ANALYTICS=
# Plausible only: the domain registered in Plausible, and optionally a
# self-hosted script URL (default https://plausible.io/js/script.js).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
