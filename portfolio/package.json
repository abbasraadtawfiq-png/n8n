{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:check": "tsx scripts/check-content.ts",
    "check:launch": "tsx scripts/check-content.ts --launch",
    "assets:placeholders": "node scripts/generate-placeholders.mjs",
    "audit:performance": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "lighthouse": "13.5.0",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
